# Database (PostgreSQL / Neon example; fill with your own credentials)
DB_DIALECT=postgres
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password
DB_NAME=your-db-name
DB_HOST=your-neon-hostname
DB_PORT=5432
DB_SSL=true

# Email (Gmail app password - create one at https://myaccount.google.com/apppasswords)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your-app-password

# JWT - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Client base URL (used in activation/forgot-password emails)
CLIENT_BASE_URL=https://jcwd230204.purwadhikabootcamp.com

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://jcwd230204.purwadhikabootcamp.com,https://jcwd-230204-client.vercel.app

# External APIs
RAJAONGKIR_API_KEY=
OPENCAGE_API_KEY=
